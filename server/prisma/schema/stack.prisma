model Stack {
  id               String      @id // slugified name, e.g. "my-nextcloud"
  displayName      String // user-facing name, e.g. "My Nextcloud"
  description      String?

  // Filesystem
  hostPath         String // absolute host path, e.g. "/opt/docktor/stacks/my-nextcloud"
  isAdoptedInPlace Boolean     @default(false) // true = brownfield adopt, limited features
  // Marks a Docktor-managed stack (e.g. the nginx-proxy/acme-companion proxy
  // stack) that the normal stop/restart/delete stack actions must refuse (D-12).
  isProtected      Boolean     @default(false)

  // State machine
  status           StackStatus @default(DRAFT)
  previousStatus   StackStatus? // stored before transient states (BACKING_UP, etc.)

  // Compose parsing cache
  lastKnownHash    String? // SHA256 of docker-compose.yml
  lastParsedAt     DateTime?
  configChanged    Boolean     @default(false) // true = file changed since last deploy
  // Latest unresolved compose parse error message (from the YAML/compose parser).
  // Null when the file currently parses. Independent of configChanged — both
  // flags can be true at once (a validly edited file that was then broken).
  configError      String?
  // SHA256 of the stack's .env file, tracked separately from lastKnownHash so
  // an external .env edit can never be mistaken for a compose-file change.
  lastEnvHash      String?

  // Import provenance (brownfield migration)
  importedFrom     String? // original host path before migration
  importedAt       DateTime?

  // Disk usage
  volumeSizeBytes  BigInt? // last measured size of ./volumes/
  volumeSizeAt     DateTime? // when volumeSizeBytes was last updated
  backupSizeBytes  BigInt? // last measured size of ./backups/ (stack-local restic repo); null = no local repo or never measured

  // Backup hooks (optional)
  backupPreHook    String? // shell command to run before backup
  backupPostHook   String? // shell command to run after backup

  // Scheduling
  backupSchedule   String? // cron expression, null = use global default
  backupRetention  String? // JSON retention policy, null = use global default

  // Issue #19 template pin (D-08): set once at creation from the variant the
  // stack was created from, never rewritten by a later template update. The
  // pin stores the repo URL, not a foreign key, so removing a TemplateRepo
  // row never touches stacks created from it.
  templateRepoUrl         String? // the repo's url at creation time
  templatePath            String? // "<template-slug>/<variant-slug>"
  templateCommitSha       String? // repo's headCommitSha at creation time
  templateContentHash     String? // the variant's contentHash at creation time, pinned forever
  // Passive "template updated" badge flag (D-08, written by plan 12-11's
  // job) — never auto-applied, purely informational.
  templateUpdateAvailable Boolean @default(false)
  // Plan 12-08's pre-deploy compose-check/port-conflict re-check result:
  // JSON {checkedAt, composeFindings, portConflicts}.
  deployWarnings          String?

  // Relations
  services      Service[]
  proxyConfigs  ProxyConfig[]
  backups       Backup[]
  statusLogs    StatusLog[]
  stackEvents   StackEvent[]
  deployments   Deployment[]
  notifications Notification[]
  incidents     StackIncident[]
  serviceHealthEvents ServiceHealthEvent[]
  volumeUsages        StackVolumeUsage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum StackStatus {
  DRAFT
  DEPLOYING
  RUNNING
  HEALTHY
  UNHEALTHY
  STOPPED
  ERROR
  UPDATING
  BACKING_UP
  RESTORING
  MIGRATING
}
